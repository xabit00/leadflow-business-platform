# ==============================================================================
# LeadFlow Backend Environment Configuration Template
# ==============================================================================

# Core Application Settings
APP_NAME=LeadFlow
ENVIRONMENT=development
DEBUG=True
PORT=8000
SECRET_KEY=change-me-in-production-leadflow-secret-key-32chars

# CORS Configuration (JSON array of allowed origins)
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# Database Connection (PostgreSQL)
# Format: postgresql://USER:PASSWORD@HOST:PORT/DB_NAME
DATABASE_URL=postgresql://leadflow_user:leadflow_password@localhost:5432/leadflow_db

# Logging
LOG_LEVEL=INFO

# ==============================================================================
# Third-Party Integrations (Optional in Level 0 Development)
# ==============================================================================

# Twilio (SMS & WhatsApp Sandbox)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
TWILIO_WHATSAPP_NUMBER=whatsapp:+14155238886

# Stripe (Test Mode)
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# Google Calendar (OAuth 2.0)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/integrations/google-calendar/callback

# Telegram Bot (Escalation Alerts)
TELEGRAM_BOT_TOKEN=
TELEGRAM_ESCALATION_CHAT_ID=
