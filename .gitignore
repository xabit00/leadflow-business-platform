# LeadFlow - .gitignore

# Dependencies
node_modules/
.pnp
.pnp.js

# Python Virtual Environments
.venv/
venv/
ENV/
env/
env.bak/
venv.bak/

# Python Bytecode and Cache
__pycache__/
*.py[cod]
*$py.class
*.so
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.mypy_cache/
.ruff_cache/

# Environment and Secret Files
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
*.pem
*.key
*.cert
*.crt
*.pfx
*.p12
*.secret

# Allow example environment files
!.env.example
!frontend/.env.example
!backend/.env.example

# Build Artifacts
dist/
build/
*.egg-info/
*.egg
eggs/
parts/
var/
sdist/
develop-eggs/
dist-ssr/
*.tsbuildinfo
frontend/vite.config.js
frontend/vite.config.d.ts

# Database and Storage
*.sqlite
*.sqlite3
*.db
postgres_data/

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# IDE and Editor Directories
.vscode/
.idea/
*.sublime-project
*.sublime-workspace
*.swp
*.swo
*~

# Operating System Files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
Desktop.ini
